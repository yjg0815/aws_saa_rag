# 템플릿 — 실제 값을 넣지 말 것. 이 파일은 커밋해도 안전하다.
# 로컬 개발: 이 파일을 .streamlit/secrets.toml로 복사한 뒤 실제 값을 채운다
#   (.streamlit/secrets.toml은 .gitignore에 등록돼 있어 커밋되지 않는다).
# 배포(Streamlit Cloud): share.streamlit.io > App settings > Secrets에
#   아래와 같은 키로 실제 값을 붙여넣는다.

POSTGRES_HOST = "xxx.supabase.co"
POSTGRES_PORT = "5432"
POSTGRES_USER = "postgres"
POSTGRES_PASSWORD = ""
POSTGRES_DB = "postgres"
POSTGRES_SSLMODE = "require"

VOYAGE_API_KEY = ""
VOYAGE_MODEL = "voyage-4-lite"
VOYAGE_RERANK_MODEL = "rerank-2.5-lite"

# 검색 UI 접근 게이트용 비밀번호 (정식 인증 아님, 최소한의 게이트).
APP_PASSWORD = ""
