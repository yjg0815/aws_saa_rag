# Postgres — notion_rag_test/docker-compose.yml로 이미 떠 있는 pgvector
# 컨테이너에 접속한다(새 컨테이너 아님). USER/PASSWORD/HOST/PORT는 그
# 컨테이너의 값(docker-compose.yml 기준 기본값)과 동일하게 맞추고,
# DB만 aws_saa_rag로 새로 만든다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=notion_rag
POSTGRES_PASSWORD=notion_rag
POSTGRES_DB=aws_saa_rag

# Voyage AI
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
VOYAGE_RERANK_MODEL=rerank-2.5-lite
